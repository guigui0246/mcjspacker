{
  "name": "mcjspacker",
  "version": "0.3.0",
  "description": "A library to build Minecraft datapacks in JavaScript.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test"
  },
  "type": "module",
