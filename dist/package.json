{
  "name": "mcjspacker",
  "version": "0.3.0",
  "description": "A library to build Minecraft datapacks in JavaScript.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "watch": "chokidar example --initial -c \"npm run build\"",
    "build": "node example/datapack.js"
  },
  "type": "module",
  "directories": {
    "example": "example"
  },
  "bin": {
    "mcjspacker": "./bin/init.ts"
  },
  "keywords": [
    "minecraft",
    "datapack",
    "javascript",
    "mcjs"
  ],
  "author": "ofekn",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "chokidar-cli": "^3.0.0",
    "typescript": "^7.0.2"
  }
}
